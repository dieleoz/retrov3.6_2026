#!/usr/bin/env bash
# Delega en el hook del Orquestador: la regla vive una sola vez. No se edita aquí.
for h in "${ORQUESTADOR:-}/skills/init-proyecto/hooks/pre-commit" \
         "/d/IT/Arquitec_Orquestador/skills/init-proyecto/hooks/pre-commit"; do
  [ -f "$h" ] && exec bash "$h"
done
echo "pre-commit: no encuentro el hook del Orquestador (bash instalar.sh). Commit parado." >&2
exit 1
