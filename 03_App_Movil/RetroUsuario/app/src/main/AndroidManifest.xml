<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dpi.retrousuario">

    <!-- targetSdkVersion 30: BLUETOOTH y BLUETOOTH_ADMIN se conceden en la instalacion. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- RF-USR-06/M-8: GPS es opcional. arq C2 (condicion sobre 0.3.1): ACCESS_FINE_LOCATION SI se
         pide en tiempo de ejecucion, al entrar a medir (MedirActivity, una vez por proceso); se
         conceda o no, UbicacionGps degrada a sin_posicion igual (RF-USR-15: "sin permiso o sin
         posicion, se mide igual", nunca bloquea). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- RF-USR-15 bis: exportar a Download/RetroUsuario/. API 29-30 con almacenamiento con ambito:
         requestLegacyExternalStorage evita pedir SAF para esta primera version (README "algo que
         funcione, no perfecto"); maxSdkVersion=28 porque desde 29 el permiso ya no hace falta con
         ese flag. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity android:name=".MainActivity" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MedirActivity" android:label="@string/app_name" />
        <activity android:name=".AjustesActivity" android:label="@string/ajustes_titulo" />
    </application>
</manifest>
